# テスト専用のダミー環境変数（機密ではない）。
# 次の 3 つが同じ値を共用し、隔離したテスト用依存（docker/compose-test.yml の
# PostgreSQL / Redis）へ接続する。CI とローカルの乖離を防ぐための単一ソース。
#   - make test（ローカル: WSL ネイティブの Gradle テスト）
#   - backend-ci.yml の test ジョブ（Gradle テスト）
#   - hadolint.yml の backend-image ジョブ（backend コンテナのスモーク）
#
# 方針:
#   - 値はすべて demo/demo の使い捨てダミーで機密ではない。実値は置かない。
#   - 開発用スタック（docker/compose.yml, ルート .env）とポートを分ける。
#     開発 DB=5432 / Redis=6379 に対し、テストは 5433 / 6380 を使う。
#     これにより make be-run（WSL ネイティブの開発起動）と make test を
#     同時に走らせても衝突しない。
#   - compose-test は 127.0.0.1 のみに公開し、使い捨てボリュームで毎回クリーン。
#
# application.yaml は全プレースホルダにデフォルトを持たないため、テスト起動には
# 参照される変数をすべて与える必要がある。OTEL/LGTM は起動時接続を張らないので
# エンドポイント文字列が解決できれば足り、コンテナは不要（下の OTEL_* はダミー）。

# Backend
SERVER_PORT=8080
SESSION_COOKIE_SECURE=false
SPRINGDOC_ENABLED=false

# PostgreSQL / データソース（compose-test の postgres をホスト 5433 に公開）
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=demo
DB_USERNAME=demo
DB_PASSWORD=demo
DB_SCHEMA=demo

# Redis（compose-test の redis をホスト 6380 に公開）
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_SESSION_NAMESPACE=spring:session:test

# OpenTelemetry の出力先（プレースホルダ解決用のダミー。到達しなくてよい）
OTEL_HOST=127.0.0.1
OTEL_HTTP_PORT=4318
OTEL_SERVICE_NAME=demo
MANAGEMENT_TRACING_SAMPLING_PROBABILITY=1.0
