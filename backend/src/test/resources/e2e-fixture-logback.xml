<configuration>
  <!-- E2eFixtureServer（tooling/e2e-fixture/serve.sh）だけが -Dlogback.configurationFile で読む。 -->
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <target>System.err</target>
    <encoder><pattern>%-5level [e2e-fixture] %msg%n</pattern></encoder>
  </appender>
  <logger name="com.example.demo.E2eFixtureServer" level="INFO"/>
  <root level="WARN"><appender-ref ref="CONSOLE"/></root>
</configuration>
