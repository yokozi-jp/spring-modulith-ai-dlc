<?xml version="1.0"?>
<ruleset name="pmd java rules"
		xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">
    <description>PMD ruleset for Java</description>

    <rule ref="category/java/bestpractices.xml">
        <!-- テストでは複数アサーションが自然なため無効化 -->
        <exclude name="UnitTestContainsTooManyAsserts"/>
    </rule>
    <rule ref="category/java/codestyle.xml">
        <!-- ラムダ式とメソッド参照を意図に応じて選択できるようにする -->
        <exclude name="LambdaCanBeMethodReference"/>
        <!-- Lombok がコンストラクタを生成し、record クラスは暗黙コンストラクタを持つため無効化 -->
        <exclude name="AtLeastOneConstructor"/>
        <!-- id 等の短い変数名が頻出するため無効化 -->
        <exclude name="ShortVariable"/>
        <!-- 長い変数名は説明的で可読性が高いため無効化 -->
        <exclude name="LongVariable"/>
        <!-- ドメインモデル名が短くなることがあるため無効化 -->
        <exclude name="ShortClassName"/>
        <!-- ガード節（早期 return/throw）を自然に書くため無効化 -->
        <exclude name="OnlyOneReturn"/>
        <!-- ArchUnit の @ArchTest フィールドはルール説明として命名するため、定数命名規則（UPPER_SNAKE）と衝突する。無効化 -->
        <exclude name="FieldNamingConventions"/>
    </rule>
    <rule ref="category/java/design.xml">
        <!-- メソッドチェーン・Optional チェーン等、流暢 API では不可避なため無効化 -->
        <exclude name="LawOfDemeter"/>
        <!-- CRUD Controller は Command/DTO/Request/Response 等で import が多くなるため無効化 -->
        <exclude name="ExcessiveImports"/>
    </rule>
    <rule ref="category/java/documentation.xml">
        <!-- Javadoc の行数・行長制限は Google Java Format に委ねるため無効化 -->
        <exclude name="CommentSize"/>
    </rule>
    <rule ref="category/java/errorprone.xml"/>
    <rule ref="category/java/multithreading.xml"/>
    <rule ref="category/java/performance.xml"/>
    <rule ref="category/java/security.xml"/>

    <rule name="UseLombokSlf4j"
          language="java"
          message="Logger を手書きせず Lombok の @Slf4j を使用する。"
          class="net.sourceforge.pmd.lang.rule.xpath.XPathRule">
        <description>
            SLF4J Logger の生成を @Slf4j に統一し、Logger フィールドと LoggerFactory の直接利用を禁止する。
        </description>
        <priority>3</priority>
        <properties>
            <property name="xpath">
                <value><![CDATA[
                    //ClassType[
                        pmd-java:typeIs('org.slf4j.Logger')
                        or pmd-java:typeIs('org.slf4j.LoggerFactory')
                    ]
                    |
                    //ImportDeclaration[
                        @Static = true()
                        and starts-with(@ImportedName, 'org.slf4j.LoggerFactory.')
                    ]
                ]]></value>
            </property>
        </properties>
    </rule>

    <rule name="DoNotUseLombokDataOrSetter"
          language="java"
          message="Lombok の @Data と @Setter は使用せず、record または意図を表す状態変更メソッドを使う。"
          class="net.sourceforge.pmd.lang.rule.xpath.XPathRule">
        <description>
            @Data と @Setter が生成する一括の状態変更を禁止し、Domain Model の不変条件とデータキャリアの不変性を保つ。
        </description>
        <priority>2</priority>
        <properties>
            <property name="xpath">
                <value><![CDATA[
                    //Annotation[
                        pmd-java:typeIs('lombok.Data')
                        or pmd-java:typeIs('lombok.Setter')
                    ]
                ]]></value>
            </property>
        </properties>
    </rule>
</ruleset>
