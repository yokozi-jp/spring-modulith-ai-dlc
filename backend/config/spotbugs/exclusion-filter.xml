<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
  <!-- DDD 集約/エンティティのコンストラクタでバリデーション例外を投げるのは正当なパターン -->
  <Match>
    <Bug pattern="CT_CONSTRUCTOR_THROW" />
  </Match>
  <!-- DSLContext は Spring が共有する jOOQ の Bean であり、注入して保持するのが正当なパターン -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP2" />
    <Field type="org.jooq.DSLContext" />
  </Match>
</FindBugsFilter>
