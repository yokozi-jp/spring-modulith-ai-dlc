# テスト専用のダミー環境変数のテンプレート（機密ではない）。
# 実行時に読むのは、このファイルをコピーして作る Git 除外のローカルファイル .env.test。
#   cp .env.test.example .env.test
# Task のテスト系タスクは .env.test が無ければ自動でコピーし、CI は workflow でコピーする。
# 次が同じ値を共用する。CI とローカルの乖離を防ぐための単一ソース。
#   - Gradle のテスト（task be-test、backend-ci.yml の test ジョブ）：接続先以外の設定を読む。
#     DB、Redis、決済代行の接続先は、テストの JVM が起動するコンテナの値で上書きする（ADR-085）。
#   - task be-verify-migrations：compose-test の PostgreSQL 5433 で rollback を検証する。
#   - hadolint.yml の backend-image ジョブ（backend コンテナのスモーク）
#   - task e2e（compose-test の backend と Playwright のログイン）
#
# 方針:
#   - 値はすべて demo/demo の使い捨てダミーで機密ではない。実値は置かない。
#   - 開発用スタック（docker/compose.yml, ルート .env）とポートを分ける。
#     開発 DB=5432 / Redis=6379 に対し、テストは 5433 / 6380 を使う。
#     これにより task be-run（WSL ネイティブの開発起動）と task test を
#     同時に走らせても衝突しない。
#   - compose-test は 127.0.0.1 のみに公開し、使い捨てボリュームで毎回クリーン。
#
# application.yaml は全プレースホルダにデフォルトを持たないため、テスト起動には
# 参照される変数をすべて与える必要がある。OTEL/LGTM は起動時接続を張らないので
# エンドポイント文字列が解決できれば足り、コンテナは不要（下の OTEL_* はダミー）。

# Backend
SERVER_PORT=8080
SESSION_COOKIE_SECURE=false
# 決済代行の URL。スモークは compose-test の WireMock をホスト 8082 で呼ぶ。
# E2E の backend は compose の中から http://wiremock:8080 に上書きする。Gradle のテストはテストの JVM が起動するコンテナを使う。
PAYMENT_GATEWAY_BASE_URL=http://127.0.0.1:8082
SPRINGDOC_ENABLED=true
# 失敗したイベント出版の定期の再投入（ADR-079）。
# Gradle のテストと E2E は定期の再投入なしの状態を前提にするため無効にする。テストは resubmitOnce() を直接呼ぶ。
EVENT_PUBLICATION_RESUBMISSION_ENABLED=false
EVENT_PUBLICATION_RESUBMISSION_WAIT_AGE=PT5M
EVENT_PUBLICATION_RESUBMISSION_IN_FLIGHT_STALENESS=PT4H
EVENT_PUBLICATION_RESUBMISSION_INTERVAL=PT1M

# OIDC Client
# Gradle テストは DemoApplicationTest のテスト用 ClientRegistrationRepository を使うため
# Keycloak へ接続しない。実イメージのスモークテストでは compose-test の
# backend-smoke profile を有効にし、ホストの 8081 へ公開した Keycloak を使う。
OIDC_CLIENT_ID=spring-modulith-web
OIDC_CLIENT_SECRET=local-only-web-client-secret
OIDC_ISSUER_URI=http://127.0.0.1:8081/realms/spring-modulith

# PostgreSQL / データソース（compose-test の postgres をホスト 5433 に公開）
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=demo
DB_USERNAME=demo
DB_PASSWORD=demo
# テストの同時 DB 処理を小さく制限し、接続枯渇を五秒で検出する。
DB_POOL_MAXIMUM_SIZE=4
DB_POOL_CONNECTION_TIMEOUT_MS=5000
# 接続ごとの DB の時間の上限（ミリ秒、ADR-055）。lock_timeout < statement_timeout にする。
DB_LOCK_TIMEOUT_MS=1000
DB_STATEMENT_TIMEOUT_MS=5000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=10000

# Liquibase マイグレーション接続の資格情報（be-verify-migrations / migrateDatabase が使用）。
# 接続先は上の DB_* を共有し、フォールバックはないため明示する。
# 全環境と揃えて二ロールにする。compose-test では、初期化だけに使う superuser（postgres）とは別に、
# initdb が demo_migration（DDL・所有、superuser でも BYPASSRLS でもない）と demo（DML 限定）を作成する。
# いずれも使い捨てダミーの demo パスワード。
MIGRATION_DB_USERNAME=demo_migration
MIGRATION_DB_PASSWORD=demo

# Redis（compose-test の redis をホスト 6380 に公開）
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_SESSION_NAMESPACE=spring:session:test

# OpenTelemetry の出力先（プレースホルダ解決用のダミー。到達しなくてよい）
# Gradle のテストは OTLP のログ exporter を作らない（backend/build.gradle、docs/backend/testing-infrastructure.md）。
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_SERVICE_NAME=demo-api
OTEL_SERVICE_NAMESPACE=demo
OTEL_DEPLOYMENT_ENVIRONMENT_NAME=test
MANAGEMENT_TRACING_SAMPLING_PROBABILITY=1.0

# フロントエンドの OpenTelemetry（ADR-068）。
# task e2e は --mode test でビルドし、この値で Faro を有効にする。E2E は /collect を page.route で 503 にするので、Collector は要らない。
FRONTEND_OTEL_ENABLED=true
FRONTEND_OTEL_SERVICE_NAME=demo-web

# E2E（Playwright のブラウザログイン）。docker/keycloak/realm.json の test-user と同じ使い捨てダミー。
E2E_USERNAME=test-user
E2E_PASSWORD=test-password
