# # 本番CDワークフローひな型
# #
# # このファイルは設計メモを兼ねた無効なひな型であり、GitHub Actionsから実行されません。
# # 拡張子を`.yml.example`にしている理由は、全行コメントの空ワークフローをGitHubへ認識させないためです。
# # 本番インフラが確定したらプレースホルダーを置換し、先頭のコメント記号を外して`production-cd.yml`へ改名します。
# # 説明行はコメントとして残し、YAML構造を表す行だけを有効化します。
# #
# # 現時点の仮定
# #
# # バックエンドはECRへ保存したコンテナイメージをECSサービスへデプロイします。
# # ALBは`/actuator/health/readiness`をECSタスクのreadiness確認に使います。
# # PostgreSQLはRDSを使い、アプリケーション用ロールとLiquibase用ロールを分けます。
# # AWS構成はまだ`infrastructure/`へ定義されていないため、実際のサービス名と配置方式が決まった時点でこの仮定を見直します。
# #
# # 有効化前に完了させること
# #
# # 1. `infrastructure/`へECR、ECS、ALB、RDS、CloudWatch、Secrets ManagerをIaCで定義します。
# # 2. ECRはタグを上書きできない設定にし、push時の脆弱性スキャンとイメージ署名を有効にします。
# # 3. CIは一度だけイメージをビルドし、SBOMとprovenanceを付けてECRへpushし、digestをリリース候補として保存します。
# # 4. 本番CDはソースからイメージを再ビルドせず、CIが検証した同じdigestを昇格させます。
# # 5. GitHub Environmentの`production`を作り、必須レビュー担当者とデプロイ可能なブランチまたはタグを設定します。
# # 6. GitHub OIDC用IAMロールの信頼ポリシーを、このリポジトリ、production Environment、許可したrefへ限定します。
# # 7. IAMロールにはECR参照、ECS更新、対象シークレット参照、バックアップ確認、CloudWatch参照の最小権限だけを付与します。
# # 8. ECSサービスへdeployment circuit breakerとCloudWatch alarm連動の自動ロールバックを設定します。
# # 9. RDSの自動バックアップとPoint-in-Time Recoveryを有効にし、復元訓練を完了させます。
# # 10. changesetはexpand-and-contractを守り、旧アプリケーションと新アプリケーションの併存中も後方互換にします。
# # 11. `checkCurrentSchemaTag`と`checkRollbackTag`がタグ不在時に失敗するよう、DBを直接照会する検証へ修正します。
# # 12. `be-release-migrate`と本番rollbackターゲットからローカル`.env`への必須依存を外します。
# # 13. 使用する全GitHub Actionをリリースタグではなく検証済みcommit SHAへ固定します。
# # 14. 有効化したワークフローへactionlint、zizmor、レビュー、ステージング実行を通します。
# #
# # GitHub Environmentの変数
# #
# # `AWS_REGION`には本番リソースを配置したAWSリージョンを設定します。
# # `PRODUCTION_DEPLOY_ROLE_ARN`にはGitHub OIDCから引き受けるIAMロールARNを設定します。
# # `ECR_REGISTRY`にはAWSアカウント別のECRレジストリを設定します。
# # `ECR_REPOSITORY`にはバックエンドイメージのECRリポジトリ名を設定します。
# # `ECS_CLUSTER`、`ECS_SERVICE`、`ECS_CONTAINER_NAME`には本番ECSの識別子を設定します。
# # `ECS_TASK_DEFINITION_PATH`にはIaCが生成または管理するタスク定義JSONのパスを設定します。
# # `MIGRATION_SECRET_ID`にはLiquibase専用資格情報を格納したSecrets ManagerのシークレットIDを設定します。
# # `PRODUCTION_BASE_URL`にはALBまたはCloudFront経由の本番URLを設定します。
# # `DEPLOYMENT_ALARM_NAMES`にはデプロイ判定へ使うCloudWatch Alarm名をカンマ区切りで設定します。
# #
# # Secrets Managerの`MIGRATION_SECRET_ID`は次のJSONキーを持たせます。
# #
# # `MIGRATION_DB_URL`はRDS Writerへ直接接続するJDBC URLです。
# # `MIGRATION_DB_USERNAME`はDDL権限を持つLiquibase専用ユーザーです。
# # `MIGRATION_DB_PASSWORD`はLiquibase専用ユーザーのパスワードです。
# # `MIGRATION_DB_SCHEMA`はアプリケーションと共用するスキーマ名です。
# #
# # アプリケーション用DB資格情報、OIDCクライアントシークレット、Redis資格情報はGitHubへ渡しません。
# # これらはECSタスク定義の`secrets`からSecrets ManagerまたはSSM Parameter Storeを直接参照します。
# #
# name: Production CD 🚀
#
# on:
#   workflow_dispatch:
#     inputs:
#       image_digest:
#         description: "CIがECRへpushして検証したsha256 digest"
#         required: true
#         type: string
#       confirmation:
#         description: "誤操作防止のためproductionと入力"
#         required: true
#         type: string
#
# # 本番デプロイを同時に二つ走らせると、マイグレーションとECS更新の対応関係が崩れます。
# # 実行中の本番デプロイを途中キャンセルすると状態判定が難しくなるため、後続実行は待機させます。
# concurrency:
#   group: production-cd
#   cancel-in-progress: false
#
# # ワークフロー全体では権限を付けず、ジョブへ必要な権限だけを指定します。
# permissions: {}
#
# env:
