# CI スモークテスト専用のダミー環境変数（機密ではない）。
# backend イメージを一時起動して readiness を確認するためだけに使う。
# サービスは 127.0.0.1 のみに公開され、値はすべて使い捨て。
# 本番/ローカルの実値はここには置かない（それらはルートの .env / ECS タスク定義が持つ）。
#
# 方針（なぜ Actions secrets ではなくコミット済みダミーファイルなのか）:
#   - これらの CI 値は demo/demo の使い捨てダミーで機密ではない。Actions secrets に
#     入れても秘匿の利益はなく、値が PR で見えず、変更のたびに gh と repo 管理権限が
#     要る分だけ運用が重くなる。
#   - ローカルの .env を丸ごと gh で同期する案は危険。ローカル .env には実パスワードが
#     入るため、それを CI に送るとローカル資格情報を CI へ漏らすアンチパターンになる。
#   - 機密でない CI 値は、リポジトリにコミットしたダミー env ファイルの方がレビュー可能で
#     自己完結する（この方式）。
#
#   切り分け: 非機密の CI 値はコミット済みダミー env ファイル。Actions secrets は
#   「CI が本当に必要とする実際の機密」（レジストリトークン等）だけに使い、その登録は
#   gh secret set で個別に行う。ローカル .env の一括同期はしない。
#   将来 CI に本物の機密が要るようになったら、gh secret set とワークフロー参照
#   （${{ secrets.X }}）で個別に配線する。
SERVER_PORT=8080
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=demo
DB_USERNAME=demo
DB_PASSWORD=demo
DB_SCHEMA=demo
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_SESSION_NAMESPACE=spring:session:ci
SESSION_COOKIE_SECURE=false
SPRINGDOC_ENABLED=false
OTEL_HOST=127.0.0.1
OTEL_HTTP_PORT=4318
OTEL_SERVICE_NAME=demo
MANAGEMENT_TRACING_SAMPLING_PROBABILITY=1.0
