# 使用前にこのファイルを .env へコピーし、パスワードを変更する。
#
# ここで定義するポートは「ホストから backend を直接起動するとき（task be-run）の接続先」と
# 「Compose がホストへ公開するポート」を兼ねる。コンテナ内部のポートやサービス名は
# compose.yml と application.yaml 側で扱うため、このファイルには現れない。

# Backend
# backend に到達するホスト側ポート。ホスト起動では待受ポート、
# Compose の backend profile ではコンテナの 8080 をこのポートへ公開する。
SERVER_PORT=18080
SPRINGDOC_ENABLED=true
# 決済代行の URL。ローカルでは compose の WireMock を指す。本番は既定値なしで実際の URL を注入する。
# 失敗と再投入を手で確かめるときは、WireMock の管理 API（/__admin/mappings）で失敗の応答を足す。
PAYMENT_GATEWAY_BASE_URL=http://localhost:8090
# メールの送信（ADR-125）。From のアドレスと表示名、SES の設定セットの名前。既定値はなく、未設定なら起動に失敗する。
# 表示名は UTF-8 で 45 バイト以下にする。ローカルでは ASCII にし、空白を入れない。
# Spring は .env を ISO-8859-1 の properties として読み、task be-run などは .env をシェルで読むためである。
MAIL_SENDER_FROM_ADDRESS=no-reply@example.com
MAIL_SENDER_FROM_NAME=DemoApp
MAIL_SENDER_CONFIGURATION_SET=local
# 送ってよい宛先（カンマ区切り）。* は全許可、@example.com はドメイン、user@example.com はアドレス。ローカルは * にしない。
MAIL_SENDER_ALLOWED_RECIPIENTS=@example.com
# メールを送る AWS の SDK の設定（ADR-125）。ローカルは SES v2 の API の接続先を compose の WireMock に向ける。
# アクセスキーはダミーの値で、本物の SES はこの署名を断る。本番は接続先とアクセスキーを置かず、ECS のタスクのロールと AWS_REGION を使う。
# 送ったメールは WireMock の要求の記録で読む（docs/container/compose.md の「外部システムの偽物」）。
AWS_ENDPOINT_URL_SESV2=http://localhost:8090
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=local-dummy-access-key
AWS_SECRET_ACCESS_KEY=local-dummy-secret-key
# 失敗したイベント出版の定期の再投入（ADR-079）。ローカルは短い間隔で有効にする。
# 本番と STG は true、待ち時間 PT5M、処理中の出版を FAILED に戻す時間 PT25M、間隔 PT1M にする。
EVENT_PUBLICATION_RESUBMISSION_ENABLED=true
EVENT_PUBLICATION_RESUBMISSION_WAIT_AGE=PT1M
EVENT_PUBLICATION_RESUBMISSION_IN_FLIGHT_STALENESS=PT25M
EVENT_PUBLICATION_RESUBMISSION_INTERVAL=PT30S

# OIDC Client（ローカルでは Keycloak を使用。実環境では Secrets Manager 等から注入する）
OIDC_CLIENT_ID=spring-modulith-web
OIDC_CLIENT_SECRET=local-only-web-client-secret
OIDC_ISSUER_URI=http://localhost:8080/realms/spring-modulith

# PostgreSQL / データソース
# DB_HOST・DB_PORT はホスト起動時の接続先。application.yaml が JDBC URL を組み立てる。
# スキーマ名は環境差を持たないため、LiquibaseとjOOQの設定で固定する。
# DB_USERNAME/DB_PASSWORD は DML 限定のアプリケーションロール（初回起動時に initdb が作成する）。
DB_HOST=localhost
DB_PORT=5432
DB_NAME=demo
DB_USERNAME=demo
DB_PASSWORD=replace-with-local-db-password
# ローカルの開始値。本番は PostgreSQL の接続予算と最大タスク数から算出する。
DB_POOL_MAXIMUM_SIZE=10
DB_POOL_CONNECTION_TIMEOUT_MS=5000
# 接続ごとの DB の時間の上限（ミリ秒、ADR-055）。起動時には検証しないため、次を守る。
# 三つとも 1 以上にする（0 は PostgreSQL では上限なしになり、無期限に待つ）。
# DB_LOCK_TIMEOUT_MS < DB_STATEMENT_TIMEOUT_MS <= DB_POOL_CONNECTION_TIMEOUT_MS にする。
# ローカルの開始値。本番は負荷試験で決める。
DB_LOCK_TIMEOUT_MS=1000
DB_STATEMENT_TIMEOUT_MS=5000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=10000

# Liquibase マイグレーション接続の資格情報（Gradle の migrateDatabase / jOOQ コード生成が使用）。
# DDL とスキーマ所有を持つマイグレーション専用ロール。接続先とスキーマは上の DB_* を共有し、
# 役割差はこの資格情報だけで表す（フォールバックなし。全環境で明示する）。
# compose.yml では、initdb がこのロールを superuser でも BYPASSRLS でもないロールとして作成し、
# アプリロール（DB_USERNAME）を DML 限定で作成する。
# ステージング・本番でも、この専用ロールを注入する（アプリ用の DB_* とは別アカウント）。
MIGRATION_DB_USERNAME=demo_migration
MIGRATION_DB_PASSWORD=replace-with-local-migration-db-password
# compose.yml の PostgreSQL の superuser（postgres）のパスワード。コンテナの初期化だけに使い、
# アプリ、マイグレーション、jOOQ コード生成はこのロールで接続しない。
POSTGRES_SUPERUSER_PASSWORD=replace-with-local-postgres-superuser-password

# Grafana OpenTelemetry LGTM
GRAFANA_HOST_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-local-grafana-password

# OpenTelemetry の出力先（ADR-015、ADR-068）
# OTEL_HTTP_PORT は Compose が Collector の OTLP の受信ポートをホストへ公開するために使う。
# アプリケーションは標準環境変数 OTEL_EXPORTER_OTLP_ENDPOINT を3シグナルの基点にする。
# backend profile では Compose 内の otel-collector を指す値へ上書きする。
OTEL_HTTP_PORT=4318
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=demo-api
# service.namespace と deployment.environment.name は、バックエンドとフロントエンドで共有する。
OTEL_SERVICE_NAMESPACE=demo
OTEL_DEPLOYMENT_ENVIRONMENT_NAME=local
MANAGEMENT_TRACING_SAMPLING_PROBABILITY=1.0

# フロントエンドの OpenTelemetry（Faro、ADR-068）
# OTEL_FARO_HTTP_PORT は、Compose が Collector の faro receiver をホストへ公開し、Vite の /collect の proxy が転送するポート。
OTEL_FARO_HTTP_PORT=12347
# OTEL_CSP_REPORT_HTTP_PORT は、Compose が Collector の webhook_event receiver をホストへ公開し、Vite の /csp-report の proxy が転送するポート。
OTEL_CSP_REPORT_HTTP_PORT=12348
# 既定は無効。true にしてビルドし直したときだけ、bundle に SDK が入り /collect へ送る。値は true か false にする。
FRONTEND_OTEL_ENABLED=false
FRONTEND_OTEL_SERVICE_NAME=demo-web
