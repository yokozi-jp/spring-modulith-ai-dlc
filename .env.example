# 使用前にこのファイルを .env へコピーし、パスワードを変更する。
#
# ここで定義するポートは「ホストから backend を直接起動するとき（make be-run）の接続先」と
# 「Compose がホストへ公開するポート」を兼ねる。コンテナ内部のポートやサービス名は
# compose.yml と application.yaml 側で扱うため、このファイルには現れない。

# Backend
# backend に到達するホスト側ポート。ホスト起動では待受ポート、
# Compose の backend profile ではコンテナの 8080 をこのポートへ公開する。
SERVER_PORT=18080
SESSION_COOKIE_SECURE=false
SPRINGDOC_ENABLED=true

# PostgreSQL / データソース
# DB_HOST・DB_PORT はホスト起動時の接続先。application.yaml が JDBC URL を組み立てる。
DB_HOST=localhost
DB_PORT=5432
DB_NAME=demo
DB_USERNAME=demo
DB_PASSWORD=replace-with-local-db-password
DB_SCHEMA=demo

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_SESSION_NAMESPACE=spring:session:demo

# Grafana OpenTelemetry LGTM
GRAFANA_HOST_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-local-grafana-password

# Backend の OpenTelemetry 出力先
# application.yaml が OTEL_HOST・OTEL_HTTP_PORT から各シグナルの OTLP URL を組み立てる。
# ホスト起動では localhost、backend profile では Compose 内の otel-lgtm を使う。
OTEL_HOST=localhost
OTEL_HTTP_PORT=4318
OTEL_SERVICE_NAME=demo
MANAGEMENT_TRACING_SAMPLING_PROBABILITY=1.0
