SERVER_PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/demo
DB_USERNAME=demo
DB_PASSWORD=demo
DB_SCHEMA=demo
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_SESSION_NAMESPACE=spring:session:demo
# ローカルは HTTP のため false。本番/STG（HTTPS）は true にする。
SESSION_COOKIE_SECURE=false
# ローカルは true で Swagger UI を有効化。本番は false にして無効化する。
SPRINGDOC_ENABLED=true
